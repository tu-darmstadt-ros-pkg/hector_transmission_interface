# ThreadSanitizer suppressions for hector_transmission_interface.
#
# Only this repository is built with -fsanitize=thread; rclcpp, rmw and the DDS implementation are
# not. TSan still sees their mutexes - it intercepts pthread at the libc level - but not their
# atomics, and it cannot order accesses whose lock lives in an uninstrumented module. Everything
# below is of that kind, and every entry was added against a report actually observed in this
# configuration, not in anticipation.
#
# The rule for adding one: a report about this repository own state is real. Fix it.

# --- rclcpp / rmw / DDS -----------------------------------------------------
called_from_lib:librclcpp_lifecycle.so
called_from_lib:librmw_dds_common.so
called_from_lib:librmw_cyclonedds_cpp.so
called_from_lib:librmw_implementation.so
called_from_lib:librmw.so
called_from_lib:libddsc.so

# --- Fast-DDS ---------------------------------------------------------------
# The other RMW. CI runs whatever the ros:jazzy image defaults to (Fast-DDS) while a workspace
# usually pins Cyclone, so both have to be covered or the job reports what a developer never sees.
# Same two shapes as Cyclone: lock-free internals TSan cannot order, and a teardown race where the
# DomainParticipantFactory destroys a StatusCondition while a dds.udp thread is still reading it.
called_from_lib:librmw_fastrtps_cpp.so
called_from_lib:librmw_fastrtps_shared_cpp.so
called_from_lib:libfastrtps.so
called_from_lib:libfastcdr.so
race:eprosima
mutex:eprosima
# Fast-DDS assigns std::strings from its own threads. The racing frames are libstdc++ inlined into
# the test binary with libfastrtps only further down the stack and unsymbolised, so neither
# called_from_lib nor the eprosima namespace matches; the module name does.
race:libfastrtps.so
mutex:libfastrtps.so
race:librmw_fastrtps_shared_cpp.so
called_from_lib:librclcpp.so
called_from_lib:librcl.so
called_from_lib:librcutils.so
called_from_lib:librcpputils.so
called_from_lib:libclass_loader.so
called_from_lib:liburdf.so

# --- uninstrumented ros2_control --------------------------------------------
called_from_lib:libcontroller_manager.so
called_from_lib:libcontroller_interface.so
called_from_lib:libhardware_interface.so
called_from_lib:libpal_statistics.so

# libstdc++ shared_ptr control blocks are manipulated by code inlined into the test binary while
# the block itself is allocated and ordered inside uninstrumented rclcpp, so TSan sees the refcount
# but not the synchronisation that established it. Named by the control block, so a race on the
# pointed-to object is still reported by the frames that touch the object.
# _Sp_counted rather than _Sp_counted_base: the family is _Sp_counted_base, _Sp_counted_ptr and
# _Sp_counted_ptr_inplace, and the reports arrive from whichever one holds the object. All three
# are the control block; a race on the pointed-to object is reported by the frames that touch it.
race:_Sp_counted
mutex:_Sp_counted

# --- process teardown -------------------------------------------------------
# rmw_implementation dlclose()s the DDS library while its threads still run in it, because
# rclcpp::shutdown() does not destroy the global Context. Upstream ROS 2 teardown ordering.
race:__cxa_finalize
race:_dl_fini

# --- rclcpp_lifecycle::State temporaries -------------------------------------
# State carries a mutex and locks it when copied. The lock happens inside uninstrumented
# librclcpp_lifecycle.so while the matching unlock is inlined into the instrumented test binary, so
# TSan sees an unlock with no lock. The frames give no rclcpp symbol to name - the whole copy is
# inlined - so this is scoped to the one fixture that constructs State temporaries, and to mutex
# reports only: a data race raised from that SetUp is still reported.
mutex:OffsetManagerIntegrationTest::SetUp
