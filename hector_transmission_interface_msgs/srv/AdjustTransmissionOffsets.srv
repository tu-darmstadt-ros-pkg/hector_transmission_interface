sensor_msgs/JointState external_joint_measurements
# optional: these joint states are the original joint state during the external measurement
# if not provided, the current joint states from the transmission interface will be used
sensor_msgs/JointState original_joint_state
---
float64[] offset_changes
# The joints offset_changes belongs to, in the same order. A joint whose calibration could not be
# computed is left out of both, so without these names the changes cannot be attributed.
string[] joint_names
bool success
string message
